# Local development database defaults. Change these for deployed environments.
DATABASE_URL=postgresql+asyncpg://oa:oa@postgres:5432/oa
ALEMBIC_DATABASE_URL=postgresql+psycopg2://oa:oa@postgres:5432/oa

# Keep empty until a Keepa API subscription is connected locally.
KEEPA_API_KEY=
USE_KEEPA_REAL_API=false

# Replace for any non-local deployment.
AUTH_SESSION_SECRET=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_ISSUER=

# Supplier FTP credentials belong in ignored .env.local only.
VEDELEC_FTP_USERNAME=
VEDELEC_FTP_PASSWORD=
